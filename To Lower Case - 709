class Solution {
    public String toLowerCase(String s) {
        int len = s.length();
        String ans="";
        for(int x=0;x<len;x++)
        {
            char ch=s.charAt(x);
            if(ch>='A' && ch<='Z')
            {
                ans = ans + (char)(int)(ch+32);
            }
            else
            {
                ans = ans + ch;
            }
        }
        return ans;
    }
}
