class Solution {
    public int finalValueAfterOperations(String[] operations) {
        int ans = 0;
        for(int x=0;x<operations.length;x++)
        {
            String temp = operations[x];
            if(temp.charAt(0)=='-') ans = ans - 1;
            else if(temp.charAt(0)=='+') ans = ans + 1;
            else
            {
                if(temp.charAt(1)=='+') ans+=1;
                else ans-=1;
            } 
        }
        return ans;
    }
}
