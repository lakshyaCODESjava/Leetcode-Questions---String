class Solution {
    
    public boolean isPalindrome(String s) {
        String check = "",temp="";
        for(int x=0;x<s.length();x++)
        {
            char ch = s.charAt(x);
            if(ch>='A' && ch<='Z') 
            {
                ch = (char)(ch+32);
                temp = temp + ch;
            }
            else if((ch>='a' && ch<='z') || (ch>='0' && ch<='9')) temp+=ch;
            else;
        }
        for(int x=temp.length()-1;x>=0;x--)
        {
            char ch = temp.charAt(x);
            check = check + ch;
        }
        if(temp.equals(check)) return true;
        return false;
    }
}
