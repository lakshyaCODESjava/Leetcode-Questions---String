import java.util.*;
class Solution {
    public boolean backspaceCompare(String s, String t) {
        Stack<Character> s1 = new Stack<>();
        Stack<Character> s2 = new Stack<>(); 
        String temp1="";
        String temp2 = "";
        char popped1,popped2;
        for(int x=0;x<s.length();x++)
        {
            char ch = s.charAt(x);
            if(ch=='#') 
            {
                if(!s1.isEmpty())
                popped1 = s1.pop();

                else continue;
            }
            else s1.push(ch);
        }
        while(!s1.isEmpty())
        {
            temp1 = temp1 + s1.pop();
        }



        for(int x=0;x<t.length();x++)
        {
            char ch = t.charAt(x);
            if(ch=='#') 
            {
                if(!s2.isEmpty())
                popped2 = s2.pop();

                else continue;
            }
            else s2.push(ch);
        }
        while(!s2.isEmpty())
        {
            temp2 = temp2 + s2.pop();
        }

        return temp1.equals(temp2);


       
    }
}
