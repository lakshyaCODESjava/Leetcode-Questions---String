class Solution {
    public int passwordStrength(String password) {
        int ans = 0;
        int hashsmall[]=new int[26];
        int hashcapital[]=new int[26];
        int hashdigit[]=new int[11];
        int hashspecial[]=new int[4];
        for(int x=0;x<password.length();x++)
            {
                char ch = password.charAt(x);
                if(ch>='a' && ch<='z')
                {
                    if(hashsmall[ch-'a']>=1) continue;
                    else
                    {
                        hashsmall[ch-'a']++;
                        ans++;
                    }
                }

                else if(ch>='A' && ch<='Z')
                {
                    if(hashcapital[ch-'A']>=1) continue;
                    else
                    {
                        hashcapital[ch-'A']++;
                        ans+=2;
                    }
                }

                    
                else if(ch>='0' && ch<='9')
                {
                    if(hashdigit[ch-'0']>=1) continue;
                    else
                    {
                        hashdigit[ch-'0']++;
                        ans+=3;
                    }
                }

                else
                {
                    if(ch=='!')
                    {
                        if(hashspecial[0]>=1) continue;
                        else{
                            hashspecial[0]++;
                            ans+=5;
                        }
                    }
                    else if(ch=='@')
                    {
                        if(hashspecial[1]>=1) continue;
                        else{
                            hashspecial[1]++;
                            ans+=5;
                        }
                    }
                    else if(ch=='#')
                    {
                        if(hashspecial[2]>=1) continue;
                        else{
                            hashspecial[2]++;
                            ans+=5;
                        }
                    }
                    else
                    {
                        if(hashspecial[3]>=1) continue;
                        else{
                            hashspecial[3]++;
                            ans+=5;
                        }
                    }
                }
            }
        return ans;
    }
}
