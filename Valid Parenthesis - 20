class Solution {
    public boolean validPair(char b,char a)
    {
        if(a=='(' && b==')') return true;
        else if(a=='{' && b=='}') return true;
        else if(a=='[' && b==']') return true;
        else return false;
    }
    public boolean isValid(String s) {
        if(s.length()==1) return false;
        Stack<Character> st = new Stack<>();
        for(int x=0;x<s.length();x++)
        {
            if(s.charAt(x)=='(' || s.charAt(x)=='{' || s.charAt(x)=='[') st.push(s.charAt(x));
            if(s.charAt(x)==')' || s.charAt(x)=='}' || s.charAt(x)==']')
            {
                if(st.empty()) return false;
                char temp = st.pop();
                if(validPair(s.charAt(x),temp)==false) return false;
            }
        }
        return st.empty();
    }
}
